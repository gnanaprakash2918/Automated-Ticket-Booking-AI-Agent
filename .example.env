# Application Environment
# Options: "development" or "production"
APP_ENV="development"

# Options:
#   "beautifulsoup": Fastest, uses CSS selectors. Good for standard layouts.
#   "gemini": Uses Google's Gemini API. Best for complex/changing HTML.
#   "ollama": Uses local Ollama instance. Good for privacy/offline.
PARSER_STRATEGY="beautifulsoup"

# Used by the LLM Factory to determine which LLM to instantiate for other tasks.
# Options: "gemini", "ollama"
LLM_PROVIDER="gemini"

# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_CONCURRENCY_LIMIT=5
GEMINI_LOAD_TIMEOUT=60

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OLLAMA_CONCURRENCY_LIMIT=2
OLLAMA_LOAD_TIMEOUT=120